{
  "name": "dsh-uxexo",
  "version": "1.9.2",
  "description": "DSH web 界面增强：设置页里每一项都能即时开关（中文优先 / 0.5 窄体等宽字体方案、Solarized 浅色配色、紧凑布局、思考/工具链折叠胶囊、官方余额 + 本轮成本 + 用量图表）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "plugin",
    "generative-ui"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6 || ^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
